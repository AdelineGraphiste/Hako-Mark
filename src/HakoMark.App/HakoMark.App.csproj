<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>HakoMark</AssemblyName>
    <Version>0.3.3</Version>
    <ApplicationIcon>../../assets/HakoMark.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Hako Mark</Product>
    <Company>Adeline Courtois</Company>
    <Authors>Adeline Courtois</Authors>
    <Description>Outil d’annotation d’écran pour présentations, démonstrations, visios et tutoriels.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HakoMark.Core\HakoMark.Core.csproj" />
    <ProjectReference Include="..\HakoMark.Overlay\HakoMark.Overlay.csproj" />
    <ProjectReference Include="..\HakoMark.UI\HakoMark.UI.csproj" />
    <ProjectReference Include="..\HakoMark.Windows\HakoMark.Windows.csproj" />
  </ItemGroup>
</Project>
